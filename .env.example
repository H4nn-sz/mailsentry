# Copie este archivo como .env y complete los valores.
# MailSentry lo lee al iniciar; nunca lo suba a un repositorio.

# Base de datos PostgreSQL (Supabase): pegue aquí la cadena "Session pooler" de
# Supabase → Connect, reemplazando [YOUR-PASSWORD]. Vacío = SQLite local (data/).
MAILSENTRY_DB_URL=

# Contraseñas de aplicación de los buzones IMAP (una por buzón, el nombre lo define password_env)
MAILSENTRY_PASS_GERENCIA=

# Secreto de la aplicación registrada en Azure (buzones Microsoft 365 vía Graph)
MAILSENTRY_GRAPH_SECRET=

# API key de VirusTotal (opcional)
VT_API_KEY=

# Token para la API REST de MailSentry (opcional; genere uno largo y aleatorio)
MAILSENTRY_API_TOKEN=
